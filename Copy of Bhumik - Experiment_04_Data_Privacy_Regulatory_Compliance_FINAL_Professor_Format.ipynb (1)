lter_executed = (\n","    variable_exists(\"secure_filter_test\")\n","    and variable_exists(\"scanned_results\")\n",")\n","\n","security_filter_passed = (\n","    security_filter_executed\n","    and len(secure_filter_test) == len(scanned_results)\n",")\n","\n","add_check(\n","    \"25. Security Filtering\",\n","    function_exists(\n","        \"filter_suspicious_retrieved_content\"\n","    ),\n","    security_filter_executed,\n","    security_filter_passed,\n","    (\n","        \"Retrieved content security filtering executed.\"\n","        if security_filter_executed\n","        else \"Security filtering test was not executed.\"\n","    )\n",")\n","\n","\n","user_security_executed = (\n","    variable_exists(\"malicious_query_security\")\n","    and isinstance(\n","        malicious_query_security,\n","        dict\n","    )\n",")\n","\n","user_security_passed = (\n","    user_security_executed\n","    and malicious_query_security.get(\"safe\") is False\n",")\n","\n","add_check(\n","    \"26. User Query Security Validation\",\n","    function_exists(\"validate_user_query\"),\n","    user_security_executed,\n","    user_security_passed,\n","    (\n","        f\"Malicious query safe flag = \"\n","        f\"{malicious_query_security.get('safe')}.\"\n","        if user_security_executed\n","        else \"User-query security test was not executed.\"\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# SECURE END-TO-END PIPELINE\n","# ------------------------------------------------------------\n","\n","secure_executed = (\n","    variable_exists(\"secure_query_result\")\n","    and isinstance(\n","        secure_query_result,\n","        dict\n","    )\n",")\n","\n","secure_passed = (\n","    secure_executed\n","    and secure_query_result.get(\"status\") == \"SUCCESS\"\n","    and secure_query_result.get(\"relevant_count\", 0) > 0\n","    and len(\n","        secure_query_result.get(\"sources\", [])\n","    ) > 0\n","