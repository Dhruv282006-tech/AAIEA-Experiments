ntation else \"NO\",\n","        \"Executed\": \"YES\" if executed else \"NO\",\n","        \"Status\": status,\n","        \"Evidence\": evidence,\n","        \"Category\": category\n","    })\n","\n","\n","def function_exists(*names):\n","    return any(\n","        callable(globals().get(name))\n","        for name in names\n","    )\n","\n","\n","def variable_exists(name):\n","    return name in globals()\n","\n","\n","# ============================================================\n","# 1–10 DOCUMENT PROCESSING\n","# ============================================================\n","\n","add_check(\n","    \"1. Document Ingestion\",\n","    function_exists(\"ingest_document\"),\n","    variable_exists(\"DOC_FILES\"),\n","    variable_exists(\"DOC_FILES\") and len(DOC_FILES) >= 4,\n","    f\"{len(DOC_FILES) if variable_exists('DOC_FILES') else 0} document(s) found.\"\n",")\n","\n","\n","add_check(\n","    \"2. PDF/DOCX Text Extraction\",\n","    function_exists(\n","        \"extract_pdf_text\",\n","        \"extract_docx_text\"\n","    ),\n","    variable_exists(\"all_chunks\"),\n","    variable_exists(\"all_chunks\") and len(all_chunks) > 0,\n","    \"Extracted text produced document chunks.\"\n",")\n","\n","\n","add_check(\n","    \"3. Text Cleaning\",\n","    function_exists(\"clean_text\"),\n","    variable_exists(\"all_chunks\"),\n","    variable_exists(\"all_chunks\") and len(all_chunks) > 0,\n","    \"Cleaned text is present in processed chunks.\"\n",")\n","\n","\n","add_check(\n","    \"4. Document Chunking\",\n","    function_exists(\"chunk_text\"),\n","    variable_exists(\"all_chunks\"),\n","    variable_exists(\"all_chunks\") and len(all_chunks) > 1,\n","    f\"{len(all_chunks) if variable_exists('all_chunks') else 0} chunks detected.\"\n",")\n","\n","\n","metadata_ok = (\n","    variable_exists(\"all_chunks\")\n","    and len(all_chunks) > 0\n","    and {\n","        \"chunk_id\",\n","        \"document\",\n","        \"text\"\n","    }.issubset(all_chunks[0])\n",")\n","\n","add_check(\n","    \"5. Chunk Metadata\",\n","    variable_exists(\"all_chunks\"),\n","    variable_exists(\"all_chunks\"),\n","    metadata_ok,\n","    \"chunk_id, document and text metadata verified.\"\n",")\n","\n","\n","embedding_model_ok = variable_exists(\"embedding_model\")\n","embedding_execution_ok = (\n","    variable_exists(\"document_embeddings\")\n","    and len(document_embeddings) > 0\n",")\n","\n","add_check(\n","    \"6. Embedding Model\",\n","    embedding_model_ok,\n","    embedding_execution_ok,\n","    embedding_execution_ok,\n","    \"Embedding model loaded and document embeddings generated.\"\n",")\n","\n","\n","embedding_ok = (\n","    variable_exists(\"document_embeddings\")\n","    and isinstance(document_embeddings, np.ndarray)\n","    and document_embeddings.size > 0\n",")\n","\n","add_check(\n","    \"7. Document Embeddings\",\n","    variable_exists(\"document_embeddings\"),\n","    embedding_ok,\n","    embedding_ok,\n","    f\"Embedding shape: {document_embeddings.shape if variable_exists('document_embeddings') else 'N/A'}\"\n",")\n","\n","\n","faiss_ok = (\n","    variable_exists(\"vector_index\")\n","    and vector_index.ntotal > 0\n",")\n","\n","add_check(\n","    \"8. FAISS Vector Index\",\n","    variable_exists(\"vector_index\"),\n","    faiss_ok,\n","    faiss_ok,\n","    f\"FAISS index contains {vector_index.ntotal if variable_exists('vector_index') else 0} vectors.\"\n",")\n","\n","\n","index_saved_ok = (\n","    variable_exists(\"INDEX_FILE\")\n","    and INDEX_FILE.exists()\n",")\n","\n","add_check(\n","    \"9. Vector Index Saved\",\n","    variable_exists(\"INDEX_FILE\"),\n","    index_saved_ok,\n","    index_saved_ok,\n","    f\"Index saved: {INDEX_FILE if variable_exists('INDEX_FILE') else 'N/A'}\",\n","    \"Recommended\"\n",")\n","\n","\n","metadata_saved_ok = (\n","    variable_exists(\"METADATA_FILE\")\n","    and METADATA_FILE.exists()\n",")\n","\n","add_check(\n","    \"10. Metadata File Saved\",\n","    variable_exists(\"METADATA_FILE\"),\n","    metadata_saved_ok,\n","    metadata_saved_ok,\n","    f\"Metadata saved: {METADATA_FILE if variable_exists('METADATA_FILE') else 'N/A'}\",\n","    \"Recommended\"\n",")\n","\n","\n","# ============================================================\n","# 11–19 RETRIEVAL + GENERATION\n","# ============================================================\n","\n","structured_ok = (\n","    variable_exists(\"query_request\")\n","    and isinstance(query_request, dict)\n","    and \"query\" in query_request\n",")\n","\n","add_check(\n","    \"11. Structured Query\",\n","    function_exists(\"create_query\"),\n","    structured_ok,\n","    structured_ok,\n","    \"Structured query object generated.\"\n",")\n","\n","\n","query_embedding_ok = (\n","    variable_exists(\"query_embedding\")\n","    and isinstance(query_embedding, np.ndarray)\n","    and query_embedding.size > 0\n",")\n","\n","add_check(\n","    \"12. Query Embedding\",\n","    function_exists(\"create_query_embedding\"),\n","    query_embedding_ok,\n","    query_embedding_ok,\n","    \"Query embedding generated successfully.\"\n",")\n","\n","\n","retrieval_ok = (\n","    variable_exists(\"retrieved_results\")\n","    and isinstance(retrieved_results, list)\n","    and len(retrieved_results) > 0\n",")\n","\n","add_check(\n","    \"13. Semantic Search\",\n","    function_exists(\"semantic_search\"),\n","    retrieval_ok,\n","    retrieval_ok,\n","    f\"Semantic search returned {len(retrieved_results) if variable_exists('retrieved_results') else 0} results.\"\n",")\n","\n","\n","similarity_ok = (\n","    retrieval_ok\n","    and all(\n","        \"similarity\" in r\n","        and isinstance(r[\"similarity\"], (int, float))\n","        for r in retrieved_results\n","    )\n",")\n","\n","add_check(\n","    \"14. Similarity Calculation\",\n","    function_exists(\"distance_to_similarity\"),\n","    similarity_ok,\n","    similarity_ok,\n","    \"Similarity values are present for retrieved results.\"\n",")\n","\n","\n","filter_ok = (\n","    variable_exists(\"relevant_results\")\n","    and isinstance(relevant_results, list)\n","    and len(relevant_results) > 0\n",")\n","\n","add_check(\n","    \"15. Relevance Threshold / Filtering\",\n","    function_exists(\"filter_relevant_results\"),\n","    filter_ok,\n","    filter_ok,\n","    f\"Relevant results after threshold filtering: {len(relevant_results) if variable_exists('relevant_results') else 0}.\"\n",")\n","\n","\n","context_ok = (\n","    variable_exists(\"relevant_context\")\n","    and isinstance(relevant_context, str)\n","    and len(relevant_context.strip()) > 0\n",")\n","\n","add_check(\n","    \"16. Context Augmentation\",\n","    function_exists(\"build_context\"),\n","    context_ok,\n","    context_ok,\n","    \"Retrieved legal context generated.\"\n",")\n","\n","\n","llm_ok = (\n","    variable_exists(\"raw_answer\")\n","    and isinstance(raw_answer, str)\n","    and len(raw_answer.strip()) > 0\n",")\n","\n","add_check(\n","    \"17. Local LLM Response Generation\",\n","    function_exists(\"generate_local_llm\"),\n","    llm_ok,\n","    llm_ok,\n","    f\"Local LLM response generated using {LLM_MODEL_NAME}.\"\n",")\n","\n","\n","grounded_prompt_ok = (\n","    variable_exists(\"grounded_prompt\")\n","    and isinstance(grounded_prompt, str)\n","    and len(grounded_prompt.strip()) > 0\n",")\n","\n","add_check(\n","    \"18. Grounded Prompt\",\n","    function_exists(\"build_grounded_prompt\"),\n","    grounded_prompt_ok,\n","    grounded_prompt_ok,\n","    \"Grounded prompt generated.\"\n",")\n","\n","\n","source_ok = (\n","    variable_exists(\"source_validation\")\n","    and isinstance(source_validation, dict)\n","    and source_validation.get(\"source_count\", 0) > 0\n",")\n","\n","add_check(\n","    \"19. Source Traceability\",\n","    function_exists(\"validate_sources\"),\n","    source_ok,\n","    source_ok,\n","    f\"Verified sources: {source_validation.get('source_count', 0) if variable_exists('source_validation') else 0}.\"\n",")\n","\n","\n","# ============================================================\n","# 20–23 RELIABILITY\n","# ============================================================\n","\n","grounding_executed = (\n","    variable_exists(\"grounding_result\")\n","    and isinstance(grounding_result, dict)\n","    and \"grounded\" in grounding_result\n","    and \"support_score\" in grounding_result\n",")\n","\n","grounding_passed = (\n","    grounding_executed\n","    and bool(grounding_result.get(\"grounded\")) is True\n","    and float(grounding_result.get(\"support_score\", 0)) > 0\n",")\n","\n","add_check(\n","    \"20. Answer Grounding Validation\",\n","    function_exists(\"validate_grounding\"),\n","    grounding_executed,\n","    grounding_passed,\n","    (\n","        f\"Grounded={grounding_result.get('grounded')}, \"\n","        f\"support={grounding_result.get('support_score', 0)}.\"\n","        if grounding_executed\n","        else \"Grounding validation was not executed.\"\n","    )\n",")\n","\n","\n","confidence_executed = (\n","    variable_exists(\"confidence_result\")\n","    and isinstance(confidence_result, dict)\n","    and \"confidence\" in confidence_result\n",")\n","\n","confidence_passed = (\n","    confidence_executed\n","    and isinstance(\n","        confidence_result.get(\"confidence\"),\n","        (int, float)\n","    )\n","    and float(confidence_result.get(\"confidence\", 0)) > 0\n",")\n","\n","add_check(\n","    \"21. Confidence Estimation\",\n","    function_exists(\"calculate_confidence\"),\n","    confidence_executed,\n","    confidence_passed,\n","    (\n","        f\"Confidence={confidence_result.get('confidence')}\"\n","        if confidence_executed\n","        else \"Confidence estimation was not executed.\"\n","    )\n",")\n","\n","\n","error_handling_executed = (\n","    variable_exists(\"robust_result\")\n","    and isinstance(robust_result, dict)\