      \"chunk_id\": 6\n","    }\n","  ],\n","  \"source_count\": 5,\n","  \"valid\": true\n","}\n"]}],"source":["# ============================================================\n","# STEP 36: SOURCE VALIDATION\n","# ============================================================\n","def validate_sources(answer,results):\n","    sources=[{'document':r['document'],'page':r['page'],'chunk_id':r['chunk_id']} for r in results]\n","    return {'sources':sources,'source_count':len(sources),'valid':len(sources)>0}\n","source_validation=validate_sources(raw_answer,relevant_results)\n","print(json.dumps(source_validation,indent=2))"]},{"cell_type":"code","execution_count":null,"id":"df37e49f","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"df37e49f","executionInfo":{"status":"ok","timestamp":1788988218439,"user_tz":-330,"elapsed":35,"user":{"displayName":"Bhumik Gianani","userId":"05120595561912954724"}},"outputId":"43f7b6d6-1027-46fd-9564-184b130e5050"},"outputs":[{"output_type":"stream","name":"stdout","text":["Verified source references: 5\n"]}],"source":["# ============================================================\n","# STEP 37: TEST SOURCE TRACEABILITY\n","# ============================================================\n","assert source_validation['valid'] if relevant_results else True\n","print('Verified source references:',source_validation['source_count'])"]},{"cell_type":"code","execution_count":null,"id":"db7d9ad3","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"db7d9ad3","executionInfo":{"status":"ok","timestamp":1788988218445,"user_tz":-330,"elapsed":6,"user":{"displayName":"Bhumik Gianani","userId":"05120595561912954724"}},"outputId":"c56cb3d3-b00b-40f4-94e0-f5069b263e93"},"outputs":[{"output_type":"stream","name":"stdout","text":["{\n","  \"grounded\": true,\n","  \"support_score\": 1.0,\n","  \"reason\": \"Lexical support heuristic over retrieved evidence\"\n","}\n"]}],"source":["# ============================================================\n","# STEP 38: ANSWER GROUNDING VALIDATION\n","# ============================================================\n","def validate_grounding(answer,results):\n","    if not answer.strip() or not results: return {'grounded':False,'support_score':0.0,'reason':'No answer or evidence'}\n","    evidence=' '.join(r['text'].lower() for r in results)\n","    terms=[t for t in re.findall(r'\\b[a-zA-Z]{5,}\\b',answer.lower()) if t not in {'there','which','under','these','their','about','using','answer'}]\n","    overlap=sum(1 for t in terms if t in evidence)/max(1,len(terms))\n","    return {'grounded':overlap>=0.10,'support_score':round(overlap,3),'reason':'Lexical support heuristic over retrieved evidence'}\n","grounding_result=validate_grounding(raw_answer,relevant_results); print(json.dumps(grounding_result,indent=2))"]},{"cell_type":"code","execution_count":null,"id":"964d282b","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"964d282b","executionInfo":{"status":"ok","timestamp":1788988218457,"user_tz":-330,"elapsed":11,"user":{"displayName":"Bhumik Gianani","userId":"05120595561912954724"}},"outputId":"c99f60bb-e5e4-4a91-ce7b-b56dfa4c34c8"},"outputs":[{"output_type":"stream","name":"stdout","text":["{\n","  \"confidence\": 0.754,\n","  \"average_similarity\": 0.59,\n","  \"grounding_support\": 1.0\n","}\n"]}],"source":["# ============================================================\n","# STEP 39: FINAL CONFIDENCE ESTIMATION\n","# ============================================================\n","def calculate_confidence(results,grounding):\n","    sim=float(np.mean([r['similarity'] for r in results])) if results else 0.0\n","    ground=float(grounding.get('support_score',0.0))\n","    confidence=round(min(1.0,0.6*sim+0.4*ground),3)\n","    return {'confidence':confidence,'average_similarity':round(sim,3),'grounding_support':ground}\n","confidence_result=calculate_confidence(relevant_results,grounding_result); print(json.dumps(confidence_result,inde