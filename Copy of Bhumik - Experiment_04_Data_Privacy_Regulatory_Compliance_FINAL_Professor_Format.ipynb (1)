"# ============================================================\n","\n","def semantic_search(query_request):\n","\n","    # --------------------------------------------------------\n","    # Create embedding for the user query\n","    # --------------------------------------------------------\n","\n","    q = create_query_embedding(\n","        query_request[\"query\"]\n","    )\n","\n","    filt = query_request.get(\n","        \"document_filter\"\n","    )\n","\n","    k = query_request[\"top_k\"]\n","\n","\n","    # --------------------------------------------------------\n","    # Document-filtered semantic search\n","    # --------------------------------------------------------\n","\n","    if filt:\n","\n","        ids = [\n","            i\n","            for i, m in enumerate(all_chunks)\n","            if m[\"document\"] == filt\n","        ]\n","\n","        if not ids:\n","            return []\n","\n","        sub_index = faiss.IndexFlatL2(\n","            embedding_dim\n","        )\n","\n","        sub_index.add(\n","            document_embeddings[ids]\n","        )\n","\n","        D, I = sub_index.search(\n","            q,\n","            min(k, len(ids))\n","        )\n","\n","        pairs = [\n","            (\n","                float(distance),\n","                ids[int(local_index)]\n","            )\n","            for distance, local_index\n","            in zip(D[0], I[0])\n","        ]\n","\n","    # --------------------------------------------------------\n","    # Normal search across all documents\n","    # --------------------------------------------------------\n","\n","    else:\n","\n","        D, I = vector_index.search(\n","            q,\n","            min(k, vector_index.ntotal)\n","        )\n","\n","        pairs = [\n","            (\n","                float(distance),\n","                int(index)\n","            )\n","            for distance, index\n","            in zip(D[0], I[0])\n","        ]\n","\n","\n","    #